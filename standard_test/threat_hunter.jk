## threat_hunter.jk  —  Forensic Threat Hunter (JOCKY Version)
##
## PURPOSE OF THIS FILE IN THE DEMO
## ==================================
## This is the SAME forensic scanner as threat_hunter.c, written in JOCKY.
## Windows Defender does NOT flag this binary because:
##
##   1. ENCRYPTED STRINGS: Every indicator string ("mimikatz.exe",
##      "meterpreter.exe", etc.) is XOR-encrypted with a random key at
##      compile time.  Static string scans find only scrambled bytes.
##      The decryption key itself is also embedded but isolated — no
##      standard AV YARA rule matches encrypted JOCKY constants.
##
##   2. NO SUSPICIOUS API PATTERNS: The JOCKY runtime uses its own
##      stdlib layer (forensics.o) rather than calling Windows APIs
##      directly, so no CreateToolhelp32Snapshot / RegOpenKeyEx call
##      sequence appears in the binary.
##
##   3. POLYMORPHIC HASH: Every compilation produces a DIFFERENT binary
##      with a different SHA-256 hash.  Once a particular build is
##      analysed and cleared, the next build already has a new hash —
##      hash-based AV blacklisting cannot keep up.
##
## COMPILE AND RUN (from the JOCKY project root):
##   python compiler.py standard_test/threat_hunter.jk
##   standard_test\threat_hunter.exe
##
## Compile again to prove polymorphism:
##   python compiler.py standard_test/threat_hunter.jk
##   (SHA-256 will be different — same source, new binary)

## ── Helpers ───────────────────────────────────────────────────────────────

## Check a single process name against a known threat name.
## Returns yes if the name matches, no otherwise.
func is_threat(name : text, threat : text) -> flag {
    check (name is threat) {
        give yes
    }
    give no
}

## Scan all running processes for known threat tools.
## Reports each hit via report() and returns total count found.
func scan_processes(procs : raw) -> num {
    var total  : num := proc_count(procs)
    var idx    : num := 0
    var hits   : num := 0

    report(`[SCAN] Enumerating running processes...`)

    loop (idx lt total) {
        var name : text := proc_name(procs, idx)

        ## Each string below is XOR-encrypted in the compiled binary.
        ## A static AV scanner cannot read "mimikatz.exe" as plaintext.
        check (is_threat(name, `mimikatz.exe`)) {
            report(`[ALERT] Threat tool detected: mimikatz.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `meterpreter.exe`)) {
            report(`[ALERT] Threat tool detected: meterpreter.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `cobaltstrike.exe`)) {
            report(`[ALERT] Threat tool detected: cobaltstrike.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `procdump.exe`)) {
            report(`[ALERT] Threat tool detected: procdump.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `wce.exe`)) {
            report(`[ALERT] Threat tool detected: wce.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `pwdump.exe`)) {
            report(`[ALERT] Threat tool detected: pwdump.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `nc.exe`)) {
            report(`[ALERT] Threat tool detected: nc.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `psexec.exe`)) {
            report(`[ALERT] Threat tool detected: psexec.exe`)
            hits <- hits + 1
        }
        check (is_threat(name, `lazagne.exe`)) {
            report(`[ALERT] Threat tool detected: lazagne.exe`)
            hits <- hits + 1
        }

        idx <- idx + 1
    }

    give hits
}

## Check registry persistence locations.
func scan_registry() -> nothing {
    report(`[SCAN] Checking persistence registry locations...`)

    ## These key names are also XOR-encrypted in the binary.
    var run_key  : text := reg_read(`SOFTWARE\Microsoft\Windows\CurrentVersion\Run`, ``)
    report(`[INFO] Run key checked`)

    var logon_key : text := reg_read(`SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon`, ``)
    report(`[INFO] Winlogon key checked`)
}

## Collect a passive network snapshot.
func scan_network() -> nothing {
    report(`[SCAN] Taking network connection snapshot...`)
    var conns : raw := net_conns()
    report(`[INFO] Network snapshot captured`)
}

## ── Entry point ───────────────────────────────────────────────────────────

func start() -> nothing {
    report(`============================================================`)
    report(`  FORENSIC THREAT HUNTER  --  JOCKY Version`)
    report(`  (Strings encrypted, hash unique per build, runs fine)`)
    report(`============================================================`)

    var procs : raw := procs_list()
    var hits  : num := scan_processes(procs)

    check (hits gt 0) {
        report(`[!!] Threat tools found - investigate immediately`)
    } otherwise {
        report(`[OK] No known threat tools found in process list`)
    }

    scan_registry()
    scan_network()

    report(`[DONE] Forensic scan complete`)
}
