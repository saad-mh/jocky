{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja + vendored LLVM 18 SDK",
      "description": "Configure with the Ninja generator against the vendored LLVM SDK and vcpkg toolchain. Run this from a shell that already has the MSVC x64 environment loaded (an 'x64 Native Tools Command Prompt for VS 2022', or after scripts/bootstrap.ps1 has set things up) and with ninja on PATH.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vendor/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "LLVM_DIR": "${sourceDir}/.vendor/llvm-install-18.1.8/lib/cmake/llvm"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" }
  ]
}
