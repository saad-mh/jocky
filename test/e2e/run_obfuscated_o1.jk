// Obfuscation runs after the -O1 pipeline, so flatten's input has phis and
// loop-carried values from mem2reg / loop rotation. reg2mem must spill those
// before flattening or the IR fails to verify. Same answer as a plain build.

// REQUIRES: e2e
// RUN: %jocky build -O1 --obfuscate --obf-seed 88 "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"

func sum_to(n: int) -> int {
    let acc = 0;
    let i = 1;
    while (i <= n) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

func fib(n: int) -> int {
    check (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

print(sum_to(100));
print(fib(15));

// CHECK:      5050
// CHECK-NEXT: 610
