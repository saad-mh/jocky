// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L1.6 acceptance: overlay an IMAGE_DOS_HEADER-shaped struct on a buffer whose
// first bytes are `4D 5A ...` and read `e_lfanew`; a rawptr overlay writes
// through the same bytes.

struct DosHeader {
    e_magic: u16,     // 0
    e_res: u16[29],   // 2 .. 59
    e_lfanew: i32,    // 60 .. 63
}

var buf: char[64];
var i = 0;
while (i < 64) {
    buf[i] = 0 as char;
    i = i + 1;
}
buf[0] = 0x4D as char;   // 'M'
buf[1] = 0x5A as char;   // 'Z'
buf[60] = 0x08 as char;
buf[61] = 0x01 as char;  // e_lfanew = 0x0108 = 264

var hdr = buf as ptr<DosHeader>;
print(hdr.e_magic);                       // 0x5A4D = 23117
print(hdr.e_lfanew);                      // 264
print(offsetof(DosHeader, e_lfanew));     // 60
print(sizeof(DosHeader));                 // 64

var raw = &buf[0] as rawptr;
var hdr2 = raw as ptr<DosHeader>;
hdr2.e_lfanew = 512;
print(hdr.e_lfanew);                      // 512  (same buffer)
print(buf[60] as int);                    // 0    (0x200 low byte)
print(buf[61] as int);                    // 2

// CHECK:      23117
// CHECK-NEXT: 264
// CHECK-NEXT: 60
// CHECK-NEXT: 64
// CHECK-NEXT: 512
// CHECK-NEXT: 0
// CHECK-NEXT: 2
