// A program built with every obfuscation pass on must still produce the exact
// same output as a plain build.

// REQUIRES: e2e
// RUN: %jocky build --obfuscate --obf-seed 123 "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"

func fib(n: int) -> int {
    check (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func mul3(x: int) -> int {
    return x * 3;
}

let i = 0;
while (i < 8) {
    print(mul3(fib(i)));
    i = i + 1;
}

// CHECK:      0
// CHECK-NEXT: 3
// CHECK-NEXT: 3
// CHECK-NEXT: 6
// CHECK-NEXT: 9
// CHECK-NEXT: 15
// CHECK-NEXT: 24
// CHECK-NEXT: 39
