// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L1.1 acceptance: & | ^ ~ << >> evaluate correctly, `>>` is arithmetic for
// signed / logical for unsigned, and precedence sits between shift, `+`, and
// the comparisons.

func page_prot(prot: u32) -> u32 {
    return (prot >> 4) & 7;
}

print(0x40 & 0xF0);         // 64
print(0x40 | 0x0F);         // 79
print(0xFF ^ 0x0F);         // 240
print(1 << 12);             // 4096
print(~0u32);               // 4294967295
print(page_prot(0x40));     // (0x40 >> 4) & 7 = 4

print(5 & 3 + 1);           // 5 & 4 = 4    (+ binds tighter than &)
print(1 << 2 == 4);         // (1<<2)==4 = yes  (<< binds tighter than ==)
print(2 + 1 << 3);          // (2+1)<<3 = 24     (+ binds tighter than <<)

let signed: i32 = -16;
print(signed >> 2);         // -4   (arithmetic)
print((signed to u32) >> 2); // 1073741820  (logical)

// CHECK:      64
// CHECK-NEXT: 79
// CHECK-NEXT: 240
// CHECK-NEXT: 4096
// CHECK-NEXT: 4294967295
// CHECK-NEXT: 4
// CHECK-NEXT: 4
// CHECK-NEXT: yes
// CHECK-NEXT: 24
// CHECK-NEXT: -4
// CHECK-NEXT: 1073741820
