// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L2.2 acceptance: a hand-written struct with C natural alignment; `sizeof` /
// `offsetof` match the layout; fields read and write; nested structs; `&s`
// crosses to a helper; whole-struct assignment copies.

struct MemoryBasicInformation {
    baseAddress: u64,
    allocationBase: u64,
    allocationProtect: u32,
    regionSize: u64,
    state: u32,
    protect: u32,
    kind: u32,
}

func region_end(mbi: ptr<MemoryBasicInformation>) -> u64 {
    return mbi.baseAddress + mbi.regionSize;
}

let mbi: MemoryBasicInformation;
mbi.baseAddress = 0x140000000;
mbi.regionSize = 0x2000;
mbi.protect = 0x40;

print(mbi.baseAddress);                 // 5368709120
print(region_end(&mbi));                // 5368709120 + 8192 = 5368717312
print(mbi.protect);                     // 64

// C layout: u64 x2 @ 0,8 ; u32 @ 16 ; pad 4 ; u64 @ 24 ; u32 x3 @ 32,36,40 ;
// size padded to 8 -> 48.
print(sizeof(MemoryBasicInformation));       // 48
print(offsetof(MemoryBasicInformation, regionSize));  // 24
print(offsetof(MemoryBasicInformation, protect));     // 36

let copy = mbi;
copy.protect = 0x20;
print(mbi.protect);                     // 64  (copy is independent)
print(copy.protect);                    // 32

// CHECK:      5368709120
// CHECK-NEXT: 5368717312
// CHECK-NEXT: 64
// CHECK-NEXT: 48
// CHECK-NEXT: 24
// CHECK-NEXT: 36
// CHECK-NEXT: 64
// CHECK-NEXT: 32
