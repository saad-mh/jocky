// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L2.7: `GetLastError()` works as a plain extern, so a JOCKY program can tell
// "call failed, here is why" apart from "call succeeded".

extern "C" SetLastError(code: u32);
extern "C" GetLastError() -> u32;

// ERROR_PARTIAL_COPY == 299
SetLastError(299u32);
print(GetLastError());        // 299

SetLastError(0u32);
print(GetLastError());        // 0

// CHECK:      299
// CHECK-NEXT: 0
