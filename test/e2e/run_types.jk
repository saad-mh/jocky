// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// End to end: one variable of each primitive type printed (L0.1 / L0.8),
// unsigned width and wraparound (L0.2), widening in arithmetic, and a
// round-trip through `as`.

func avg(a: double, b: double) -> double {
    return (a + b) / 2.0;
}

func is_even(n: int) -> flag {
    return n % 2 == 0;
}

let i: int    = -5;
let c: char   = 'K';
let b: flag   = yes;
let d: double = 3.0;
let f: float  = 1.5f;

print(i);              // -5
print(c);              // K
print(b);              // yes
print(d);              // 3
print(f);              // 1.5

let big: u32 = 4000000000;
print(big);            // 4000000000

let wrap = (0 to u64) - 1;
print(wrap);           // 18446744073709551615

print(avg(1.0, 4.0));  // 2.5
print(is_even(10));     // yes
print(is_even(i));      // no

let code = c to int;    // 'K' widened to its code point
print(code);            // 75

// CHECK:      -5
// CHECK-NEXT: K
// CHECK-NEXT: yes
// CHECK-NEXT: 3
// CHECK-NEXT: 1.5
// CHECK-NEXT: 4000000000
// CHECK-NEXT: 18446744073709551615
// CHECK-NEXT: 2.5
// CHECK-NEXT: yes
// CHECK-NEXT: no
// CHECK-NEXT: 75
