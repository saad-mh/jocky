// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"

// Sum 1..5 with a while loop, then print each countdown value's parity.
let i = 1;
let total = 0;
while (i <= 5) {
    total = total + i;
    i = i + 1;
}
print(total);

let n = 3;
while (n > 0) {
    check (n % 2 == 0) {
        print(0);
    } otherwise {
        print(1);
    }
    n = n - 1;
}

// CHECK:      15
// CHECK-NEXT: 1
// CHECK-NEXT: 0
// CHECK-NEXT: 1
