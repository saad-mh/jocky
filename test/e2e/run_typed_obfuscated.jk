// REQUIRES: e2e
// RUN: %jocky build --obfuscate --obf-seed 5 "%s" -o "%t.obf.exe"
// RUN: %jocky build "%s" -o "%t.plain.exe"
// RUN: "%t.obf.exe" | %FileCheck "%s"
// RUN: "%t.plain.exe" | %FileCheck "%s"
// RUN: %jocky build --obfuscate --obf-seed 5 "%s" > "%t.1.ll" --emit-llvm
// RUN: %jocky build --obfuscate --obf-seed 5 "%s" > "%t.2.ll" --emit-llvm
// RUN: diff "%t.1.ll" "%t.2.ll"
//
// L0.12: the obfuscation passes run on lowered IR and don't care about source
// types. A program using char[], slices, and double must give the same output
// obfuscated as plain, and a fixed --obf-seed is reproducible.

func mean(xs: double[]) -> double {
    let total = 0.0;
    let i = 0;
    while (i < xs.len) {
        total = total + xs[i];
        i = i + 1;
    }
    return total / (xs.len to double);
}

func count_upper(s: char[]) -> int {
    let n = 0;
    let i = 0;
    while (i < s.len) {
        check (s[i] >= 'A') {
            check (s[i] <= 'Z') {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

let data: double[4] = [2.0, 4.0, 6.0, 8.0];
print(mean(data[0:4]));       // 5
print(mean(data[1:3]));       // 5

let label = "AbCdEfG";
print(count_upper(label));    // 4
print(label);                 // AbCdEfG

// CHECK:      5
// CHECK-NEXT: 5
// CHECK-NEXT: 4
// CHECK-NEXT: AbCdEfG
