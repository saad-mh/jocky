// A control-flow-heavy program must give the same answer after flattening:
// nested if inside a while, so the function has many blocks to flatten.

// REQUIRES: e2e
// RUN: %jocky build --obfuscate=flatten --obf-seed 7 "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"

func collatz(n) {
    var steps = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

print(collatz(27));

// CHECK: 111
