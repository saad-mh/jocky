// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"

func add(a: int, b: int) -> int {
    return a + b;
}

func max(a: int, b: int) -> int {
    check (a > b) {
        return a;
    }
    return b;
}

func square(n: int) -> int {
    return n * n;
}

print(add(2, 40));
print(max(11, 7));
print(square(add(1, 2)));

// CHECK:      42
// CHECK-NEXT: 11
// CHECK-NEXT: 9
