// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L2.1 acceptance: an `extern "C"` declaration links and runs; `bool` crosses
// the ABI as a 4-byte int; a varargs `printf`-shaped extern passes through.
// (kernel32 / the C runtime are linked by the clang driver by default.)

extern "C" GetCurrentProcessId() -> u32;
extern "C" IsDebuggerPresent() -> flag;
extern "C" printf(fmt: ptr<char>, ...) -> i32;

let pid = GetCurrentProcessId();
print(pid > 0u32);              // yes
print(IsDebuggerPresent());     // no

let dbg: flag = IsDebuggerPresent();
check (dbg) { print(1); } otherwise { print(0); }   // 0

let fmt = "n=%d s=%s\n";
let name = "jocky";
printf(&fmt[0], 42, &name[0]);  // n=42 s=jocky

// CHECK:      yes
// CHECK-NEXT: no
// CHECK-NEXT: 0
// CHECK-NEXT: n=42 s=jocky
