// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L0.6 acceptance: fill a char[8] in a loop, pass it to func h(b: char[]),
// have h sum b[0 .. b.len) and return the total. Plus array literals, .len,
// sub-slicing, and L0.7 (a string literal is a NUL-terminated char[]).

func h(b: char[]) -> int {
    let total = 0;
    let i = 0;
    while (i < b.len) {
        total = total + (b[i] to int);
        i = i + 1;
    }
    return total;
}

let buf: char[8];
let i = 0;
while (i < 8) {
    buf[i] = (65 + i) to char;   // 'A' .. 'H'
    i = i + 1;
}
print(buf);          // ABCDEFGH
print(h(buf));       // 65+66+...+72 = 548

let t: int[3] = [10, 20, 30];
print(t[0] + t[1] + t[2]);   // 60
print(t.len);                // 3

let mid = t[1:3];
print(mid.len);      // 2
print(mid[0]);       // 20

let msg = "hi";
print(msg);          // hi
print(msg.len);      // 3  (includes the NUL)
print(msg[2] to int); // 0

// CHECK:      ABCDEFGH
// CHECK-NEXT: 548
// CHECK-NEXT: 60
// CHECK-NEXT: 3
// CHECK-NEXT: 2
// CHECK-NEXT: 20
// CHECK-NEXT: hi
// CHECK-NEXT: 3
// CHECK-NEXT: 0
