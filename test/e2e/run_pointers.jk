// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L1.2 / L1.3 acceptance: `var p: ptr<int> = null; if (p == null) { }`, the
// round-trip `var x = 7; var p = &x; *p = 9; print(x)` -> 9, `&buf[16]` a
// pointer 16 bytes into a char[], and a rawptr <-> ptr<T> round-trip.

func bump(p: ptr<int>) {
    *p = *p + 1;
}

let x = 7;
let p = &x;
*p = 9;
print(x);              // 9
bump(p);
print(x);              // 10

let q: ptr<int> = none;
check (q == none) { print(1); } otherwise { print(0); }   // 1
check (p == none) { print(1); } otherwise { print(0); }   // 0
check (p == &x)   { print(1); } otherwise { print(0); }   // 1

let buf: char[32];
let mid = &buf[16];
*mid = 'M';
print(buf[16] to int); // 77

let raw: rawptr = p to rawptr;
let again = raw to ptr<int>;
print(*again);         // 10

let pp = &p;
*pp = &x;
print(**pp);           // 10

// CHECK:      9
// CHECK-NEXT: 10
// CHECK-NEXT: 1
// CHECK-NEXT: 0
// CHECK-NEXT: 1
// CHECK-NEXT: 77
// CHECK-NEXT: 10
// CHECK-NEXT: 10
