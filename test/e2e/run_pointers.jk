// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L1.2 / L1.3 acceptance: `var p: ptr<int> = null; if (p == null) { }`, the
// round-trip `var x = 7; var p = &x; *p = 9; print(x)` -> 9, `&buf[16]` a
// pointer 16 bytes into a char[], and a rawptr <-> ptr<T> round-trip.

func bump(p: ptr<int>) {
    *p = *p + 1;
}

var x = 7;
var p = &x;
*p = 9;
print(x);              // 9
bump(p);
print(x);              // 10

var q: ptr<int> = null;
if (q == null) { print(1); } else { print(0); }   // 1
if (p == null) { print(1); } else { print(0); }   // 0
if (p == &x)   { print(1); } else { print(0); }   // 1

var buf: char[32];
var mid = &buf[16];
*mid = 'M';
print(buf[16] as int); // 77

var raw: rawptr = p as rawptr;
var again = raw as ptr<int>;
print(*again);         // 10

var pp = &p;
*pp = &x;
print(**pp);           // 10

// CHECK:      9
// CHECK-NEXT: 10
// CHECK-NEXT: 1
// CHECK-NEXT: 0
// CHECK-NEXT: 1
// CHECK-NEXT: 77
// CHECK-NEXT: 10
// CHECK-NEXT: 10
