// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// `break` leaves the innermost loop, `continue` jumps to its condition. Nested
// loops target the inner one.

let sum = 0;
let i = 0;
while (i < 100) {
    i = i + 1;
    check (i == 5) { skip; }
    check (i > 10) { stop; }
    sum = sum + i;
}
print(sum);           // 1+2+3+4+6+7+8+9+10 = 50
print(i);             // 11

let j = 0;
while (yes) {
    j = j + 1;
    check (j == 7) { stop; }
}
print(j);             // 7

// nested: break only the inner loop
let pairs = 0;
let a = 0;
while (a < 4) {
    let b = 0;
    while (b < 100) {
        check (b >= a) { stop; }
        pairs = pairs + 1;
        b = b + 1;
    }
    a = a + 1;
}
print(pairs);         // 0 + 1 + 2 + 3 = 6

// CHECK:      50
// CHECK-NEXT: 11
// CHECK-NEXT: 7
// CHECK-NEXT: 6
