// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// `break` leaves the innermost loop, `continue` jumps to its condition. Nested
// loops target the inner one.

var sum = 0;
var i = 0;
while (i < 100) {
    i = i + 1;
    if (i == 5) { continue; }
    if (i > 10) { break; }
    sum = sum + i;
}
print(sum);           // 1+2+3+4+6+7+8+9+10 = 50
print(i);             // 11

var j = 0;
while (true) {
    j = j + 1;
    if (j == 7) { break; }
}
print(j);             // 7

// nested: break only the inner loop
var pairs = 0;
var a = 0;
while (a < 4) {
    var b = 0;
    while (b < 100) {
        if (b >= a) { break; }
        pairs = pairs + 1;
        b = b + 1;
    }
    a = a + 1;
}
print(pairs);         // 0 + 1 + 2 + 3 = 6

// CHECK:      50
// CHECK-NEXT: 11
// CHECK-NEXT: 7
// CHECK-NEXT: 6
