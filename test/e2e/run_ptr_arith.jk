// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"
//
// L1.4 acceptance: `(0x1000 as rawptr) + 0x40` equals `0x1040 as rawptr`;
// `(base as ptr<int>) + 2` equals `base + 8`; `p - q` is an element count.
// L1.5 acceptance: sizeof(u32) == 4, sizeof(char[16]) == 16.

var raw_a = (0x1000 as rawptr) + 0x40;
var raw_b = 0x1040 as rawptr;
if (raw_a == raw_b) { print(1); } else { print(0); }   // 1

var base = 0x2000;
var bp = base as ptr<int>;
// A ptr<int> steps by sizeof(int) == 8: `+ 1` is `base + 8`, `+ 2` is `base + 16`.
if (((bp + 1) as u64) == ((base + 8) as u64))  { print(1); } else { print(0); }  // 1
if (((bp + 2) as u64) == ((base + 16) as u64)) { print(1); } else { print(0); }  // 1

var a: int[6] = [0, 1, 2, 3, 4, 5];
var p = &a[0];
var q = &a[5];
print(q - p);                    // 5
print(*(p + 3));                 // 3
print(*((q - 2)));               // 3
print((&a[4] - p));              // 4

var bytes: char[8];
var bp = &bytes[0];
var third = (bp as rawptr) + 3;
*(third as ptr<char>) = 'z';
print(bytes[3] as int);          // 122

print(sizeof(u32));              // 4
print(sizeof(char[16]));         // 16
print(sizeof(ptr<int>));         // 8

// CHECK:      1
// CHECK-NEXT: 1
// CHECK-NEXT: 1
// CHECK-NEXT: 5
// CHECK-NEXT: 3
// CHECK-NEXT: 3
// CHECK-NEXT: 4
// CHECK-NEXT: 122
// CHECK-NEXT: 4
// CHECK-NEXT: 16
// CHECK-NEXT: 8
