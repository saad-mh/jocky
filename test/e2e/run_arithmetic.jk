// REQUIRES: e2e
// RUN: %jocky build "%s" -o "%t.exe"
// RUN: "%t.exe" | %FileCheck "%s"

let a = 6;
let b = 7;
print(a + b);        // 13
print(b - a);        // 1
print(a * b);        // 42
print(20 / a);       // 3
print(20 % a);       // 2
print(a + b * 2);    // 20  (precedence: 6 + 14)
print(-(a - b));     // 1

// CHECK:      13
// CHECK-NEXT: 1
// CHECK-NEXT: 42
// CHECK-NEXT: 3
// CHECK-NEXT: 2
// CHECK-NEXT: 20
// CHECK-NEXT: 1
