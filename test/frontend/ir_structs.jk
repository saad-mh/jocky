// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L2.2 lowering: a named `%struct.X` type; field access is `getelementptr` by
// index; a struct variable is one `alloca`; `sizeof` / `offsetof` fold.

struct Vec3 { x: double, y: double, z: double }
struct Ray  { origin: Vec3, tag: i32 }

func get_x(r: ptr<Ray>) -> double {
    return r.origin.x;
}

let ray: Ray;
ray.origin.y = 2.0;
ray.tag = 7;
print(get_x(&ray) + (ray.tag to double));
print(sizeof(Ray) + offsetof(Ray, tag));

// CHECK-DAG: %struct.Vec3 = type { double, double, double }
// CHECK-DAG: %struct.Ray = type { %struct.Vec3, i32 }

// CHECK: define double @get_x(ptr %r)
// CHECK:   getelementptr %struct.Ray, ptr %{{.*}}, i64 0, i32 0
// CHECK:   getelementptr %struct.Vec3, ptr %{{.*}}, i64 0, i32 0
// CHECK:   load double

// CHECK-LABEL: define i64 @main()
// CHECK:   %ray = alloca %struct.Ray
// CHECK:   getelementptr %struct.Ray, ptr %ray, i64 0, i32 0
// CHECK:   getelementptr %struct.Vec3, ptr %{{.*}}, i64 0, i32 1
// CHECK:   store double 2.000000e+00
// CHECK:   getelementptr %struct.Ray, ptr %ray, i64 0, i32 1
// CHECK:   i64 56
