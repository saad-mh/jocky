// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// L2.2 diagnostics: a redefined struct, a duplicate or `void` field, a
// by-value self-reference, `.field` on a non-struct, and a bad `offsetof`.

struct Dup { a: int }
struct Dup { b: int }

struct BadField {
    x: int,
    x: flag,
}

struct Voidy { v: nothing }

struct Node {
    next: Node,
    val: int,
}

let n = 3;
let m = n.field;

let o = offsetof(Nope, x);

struct Ok { p: ptr<Ok> }
let k: Ok;
let bad = offsetof(Ok, missing);

// CHECK-DAG: :7:1: error: struct 'Dup' is defined more than once
// CHECK-DAG: :11:5: error: duplicate field 'x' in struct 'BadField'
// CHECK-DAG: :14:19: error: a struct field cannot have type 'nothing'
// CHECK-DAG: :17:11: error: struct 'Node' contains itself by value (use ptr<Node> for a self-reference)
// CHECK-DAG: :22:10: error: type int has no member 'field'
// CHECK-DAG: :24:9: error: unknown struct 'Nope'
// CHECK-DAG: :28:11: error: struct 'Ok' has no field 'missing'
