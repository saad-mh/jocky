// CHECK-NEXT:           (varref x)
// CHECK-NEXT:           (intlit 10)
// CHECK-NEXT:         )
// CHECK-NEXT:         (block
// CHECK-NEXT:           (assign
// CHECK-NEXT:             (varref x)
// CHECK-NEXT:             (unary Neg
// CHECK-NEXT:               (varref x)
// CHECK-NEXT:             )
// CHECK-NEXT:           )
// CHECK-NEXT:         )
// CHECK-NEXT:         (block
// CHECK-NEXT:           (while
// CHECK-NEXT:             (binary Gt
// CHECK-NEXT:               (varref x)
// CHECK-NEXT:               (intlit 0)
// CHECK-NEXT:             )
// CHECK-NEXT:             (block
// CHECK-NEXT:               (assign
// CHECK-NEXT:                 (varref x)
// CHECK-NEXT:                 (binary Sub
