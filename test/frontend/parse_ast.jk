// RUN: %jocky parse --dump-ast "%s" | %FileCheck "%s"
//
// `parse --dump-ast` runs sema too, so every expression shows its resolved
// type (` :int`, ` :bool`, ...). A comparison is `bool`.

func f(a: int, b: int) -> int {
    let x = a + b * 2;
    check (x < 10) {
        x = -x;
    } otherwise {
        while (x > 0) {
            x = x - 1;
        }
    }
    return x;
}

print(f(3, 4));

// CHECK:      (module
// CHECK-NEXT:   (func f (a:int b:int) -> int
// CHECK-NEXT:     (block
// CHECK-NEXT:       (vardecl x
// CHECK-NEXT:         (binary Add :int
// CHECK-NEXT:           (varref a :int)
// CHECK-NEXT:           (binary Mul :int
// CHECK-NEXT:             (varref b :int)
// CHECK-NEXT:             (intlit 2 :int)
// CHECK-NEXT:           )
// CHECK-NEXT:         )
// CHECK-NEXT:       )
// CHECK-NEXT:       (check
// CHECK-NEXT:         (binary Lt :flag
// CHECK-NEXT:           (varref x :int)
// CHECK-NEXT:           (intlit 10 :int)
// CHECK-NEXT:         )
// CHECK-NEXT:         (block
// CHECK-NEXT:           (assign
// CHECK-NEXT:             (varref x :int)
// CHECK-NEXT:             (unary Neg :int
// CHECK-NEXT:               (varref x :int)
// CHECK-NEXT:             )
// CHECK-NEXT:           )
// CHECK-NEXT:         )
// CHECK-NEXT:         (block
// CHECK-NEXT:           (while
// CHECK-NEXT:             (binary Gt :flag
// CHECK-NEXT:               (varref x :int)
// CHECK-NEXT:               (intlit 0 :int)
// CHECK-NEXT:             )
// CHECK-NEXT:             (block
// CHECK-NEXT:               (assign
// CHECK-NEXT:                 (varref x :int)
// CHECK-NEXT:                 (binary Sub :int
// CHECK-NEXT:                   (varref x :int)
// CHECK-NEXT:                   (intlit 1 :int)
// CHECK-NEXT:                 )
// CHECK-NEXT:               )
// CHECK-NEXT:             )
// CHECK-NEXT:           )
// CHECK-NEXT:         )
// CHECK-NEXT:       )
// CHECK-NEXT:       (return
// CHECK-NEXT:         (varref x :int)
// CHECK-NEXT:       )
// CHECK-NEXT:     )
// CHECK-NEXT:   )
// CHECK-NEXT:   (toplevel
// CHECK-NEXT:     (exprstmt
// CHECK-NEXT:       (call print :int
// CHECK-NEXT:         (call f :int
// CHECK-NEXT:           (intlit 3 :int)
// CHECK-NEXT:           (intlit 4 :int)
// CHECK-NEXT:         )
// CHECK-NEXT:       )
// CHECK-NEXT:     )
// CHECK-NEXT:   )
// CHECK-NEXT: )
