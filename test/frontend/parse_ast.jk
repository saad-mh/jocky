// RUN: %jocky parse --dump-ast "%s" | %FileCheck "%s"

func f(a: int, b: int) -> int {
    var x = a + b * 2;
    if (x < 10) {
        x = -x;
    } else {
        while (x > 0) {
            x = x - 1;
        }
    }
    return x;
}

print(f(3, 4));

// CHECK:      (module
// CHECK-NEXT:   (func f (a:int b:int) -> int
// CHECK-NEXT:     (block
// CHECK-NEXT:       (vardecl x
// CHECK-NEXT:         (binary Add
// CHECK-NEXT:           (varref a)
// CHECK-NEXT:           (binary Mul
// CHECK-NEXT:             (varref b)
// CHECK-NEXT:             (intlit 2)
// CHECK-NEXT:           )
// CHECK-NEXT:         )
// CHECK-NEXT:       )
