// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L0.6 lowering: a fixed array is `alloca [N x T]` + GEP; a slice is the
// `{ ptr, i64 }` struct, built with insertvalue and read with extractvalue.

func take(b: int[]) -> int {
    return b[0] + b.len;
}

var arr: int[4];
arr[2] = 99;
var lit: int[3] = [7, 8, 9];
var s = arr[1:3];
print(take(s));

// CHECK: %jocky.slice = type { ptr, i64 }

// CHECK-LABEL: define i64 @take(%jocky.slice %b)
// CHECK:         extractvalue %jocky.slice %{{.*}}, 0
// CHECK:         getelementptr i64, ptr %{{.*}}
// CHECK:         extractvalue %jocky.slice %{{.*}}, 1

// CHECK-LABEL: define i64 @main()
// CHECK-DAG:     %arr = alloca [4 x i64]
// CHECK-DAG:     %arr.lit = alloca [3 x i64]
// CHECK:         getelementptr [4 x i64], ptr %arr, i64 0, i64 0
// CHECK:         getelementptr i64, ptr %{{.*}}, i64 2
// CHECK:         store i64 99
// CHECK:         insertvalue %jocky.slice undef, ptr %{{.*}}, 0
// CHECK:         insertvalue %jocky.slice %{{.*}}, i64 2, 1
// CHECK:         call i64 @take(%jocky.slice %{{.*}})
