// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// L2.1 diagnostics: a struct crosses to an extern only by pointer, an extern is
// declared once, and argument counts are checked (varargs is "at least N").

struct Big { a: u64, b: u64, c: u64 }

extern "C" TakesStruct(s: Big) -> int;
extern "C" ReturnsStruct() -> Big;

extern "C" Dup() -> int;
extern "C" Dup() -> int;

extern "C" Fixed(a: int, b: int) -> int;
var x = Fixed(1);

extern "C" Va(fmt: ptr<char>, ...) -> int;
var y = Va();

// CHECK-DAG: :8:27: error: pass a struct to an extern by pointer ('ptr<Big>'), not by value
// CHECK-DAG: :9:1: error: an extern cannot return a struct by value
// CHECK-DAG: :12:1: error: 'Dup' is declared more than once
// CHECK-DAG: :15:9: error: function 'Fixed' expects 2 argument(s) but 1 were given
// CHECK-DAG: :18:9: error: function 'Va' expects at least 1 argument(s) but 0 were given
