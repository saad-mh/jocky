// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L1.2 / L1.3 lowering: `ptr<T>` and `rawptr` are the opaque LLVM `ptr`;
// `&lvalue` is the address (a slot or a GEP), `*p` is a load/store through it,
// `null` is `ptr null`, and a pointer comparison is `icmp eq ptr`.

func store_through(p: ptr<int>, v: int) {
    *p = v;
}

var x = 1;
store_through(&x, 42);

var buf: char[16];
var m = &buf[8];
*m = 'Q';

var q: ptr<int> = null;
if (q == &x) { print(1); }

// CHECK: define i64 @store_through(ptr %p, i64 %v)
// CHECK:   %p1 = alloca ptr
// CHECK:   %p{{[0-9]*}} = load ptr, ptr %p1
// CHECK:   store i64 %{{.*}}, ptr %p{{[0-9]*}}

// CHECK-LABEL: define i64 @main()
// CHECK:   call i64 @store_through(ptr %x, i64 42)
// CHECK:   getelementptr [16 x i8], ptr %buf, i64 0, i64 0
// CHECK:   getelementptr i8, ptr %{{.*}}, i64 8
// CHECK:   store ptr null, ptr %q
// CHECK:   icmp eq ptr %{{.*}}, %x
