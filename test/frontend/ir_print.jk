// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"

print(42);
print("hi");

// CHECK-DAG: @[[FMTI:[A-Za-z0-9_.]+]] = private unnamed_addr constant [6 x i8] c"%lld\0A\00"
// CHECK-DAG: @[[FMTS:[A-Za-z0-9_.]+]] = private unnamed_addr constant [4 x i8] c"%s\0A\00"
// CHECK-DAG: @[[HI:[A-Za-z0-9_.]+]] = private unnamed_addr constant [3 x i8] c"hi\00"

// CHECK-LABEL: define i64 @main()
// CHECK:         call i32 (ptr, ...) @printf(ptr @[[FMTI]], i64 42)
// CHECK:         call i32 (ptr, ...) @printf(ptr @[[FMTS]], ptr @[[HI]])

// CHECK: declare i32 @printf(ptr, ...)
