// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"

var a = 6;
var b = 7;
print(a + b);
print(a - b);
print(a * b);
print(a / b);
print(a % b);
print(-a);

// CHECK-LABEL: define i64 @main()
// CHECK:         = add i64
// CHECK:         = sub i64
// CHECK:         = mul i64
// CHECK:         = sdiv i64
// CHECK:         = srem i64
// CHECK:         = sub i64 0,
