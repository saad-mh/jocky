// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L0.1: the five primitives lower to i64 / i8 / i1 / double / float.
// L0.5: `as` conversions emit sext / zext / trunc / sitofp / uitofp / fptosi /
//       fptoui / fpext / fptrunc.

func prims(i: int, c: char, b: flag, d: double, f: float) -> int {
    return i;
}

func s_widen(x: i16) -> i64 { return x to i64; }
func u_widen(x: u16) -> u64 { return x to u64; }
func i_narrow(x: i64) -> i8 { return x to i8; }
func s_to_fp(x: i64) -> double { return x to double; }
func u_to_fp(x: u64) -> double { return x to double; }
func fp_to_s(x: double) -> i64 { return x to i64; }
func fp_to_u(x: double) -> u64 { return x to u64; }
func fp_widen(x: float) -> double { return x to double; }
func fp_narrow(x: double) -> float { return x to float; }

print(prims(0, 'a', yes, 0.0, 0.0f));

// CHECK: define i64 @prims(i64 %i, i8 %c, i1 %b, double %d, float %f)

// CHECK: define i64 @s_widen(i16 %x)
// CHECK:   sext i16 {{.*}} to i64
// CHECK: define i64 @u_widen(i16 %x)
// CHECK:   zext i16 {{.*}} to i64
// CHECK: define i8 @i_narrow(i64 %x)
// CHECK:   trunc i64 {{.*}} to i8
// CHECK: define double @s_to_fp(i64 %x)
// CHECK:   sitofp i64 {{.*}} to double
// CHECK: define double @u_to_fp(i64 %x)
// CHECK:   uitofp i64 {{.*}} to double
// CHECK: define i64 @fp_to_s(double %x)
// CHECK:   fptosi double {{.*}} to i64
// CHECK: define i64 @fp_to_u(double %x)
// CHECK:   fptoui double {{.*}} to i64
// CHECK: define double @fp_widen(float %x)
// CHECK:   fpext float {{.*}} to double
// CHECK: define float @fp_narrow(double %x)
// CHECK:   fptrunc double {{.*}} to float
