// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// `break` / `continue` are only valid inside a loop body.

break;

func f() -> int {
    continue;
    return 0;
}

var i = 0;
while (i < 3) {
    i = i + 1;
    break;          // fine
}

// CHECK-DAG: :5:1: error: 'break' outside a loop
// CHECK-DAG: :8:5: error: 'continue' outside a loop
