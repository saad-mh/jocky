// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// `break` / `continue` are only valid inside a loop body.

stop;

func f() -> int {
    skip;
    return 0;
}

let i = 0;
while (i < 3) {
    i = i + 1;
    stop;          // fine
}

// CHECK-DAG: :5:1: error: 'stop' outside a loop
// CHECK-DAG: :8:5: error: 'skip' outside a loop
