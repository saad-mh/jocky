// The `flatten` pass replaces a function's branch structure with a single
// dispatch loop: a `jk.dispatch` block with a `switch`, a `jk.loopend` latch,
// and a `jk.sv` state variable the blocks write instead of branching.

// RUN: %jocky build --emit-llvm --obfuscate=flatten --obf-seed 1 "%s" | %FileCheck "%s"
// RUN: %jocky build --emit-llvm "%s" | %FileCheck --check-prefix=CLEAN "%s"
// RUN: %jocky build --emit-llvm --obfuscate=flatten --obf-seed 9 "%s" > "%t.1.ll"
// RUN: %jocky build --emit-llvm --obfuscate=flatten --obf-seed 9 "%s" > "%t.2.ll"
// RUN: diff "%t.1.ll" "%t.2.ll"

func fib(n: int) -> int {
    check (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

let i = 0;
while (i < 3) {
    print(fib(i));
    i = i + 1;
}

// CHECK-LABEL: define i64 @fib(i64 %n)
// CHECK:         %jk.sv = alloca i32
// CHECK:       jk.dispatch{{[0-9]*}}:
// CHECK:         switch i32
// CHECK:       jk.loopend{{[0-9]*}}:
// CHECK:         br label %jk.dispatch
// main (the top-level while loop) is flattened too:
// CHECK-LABEL: define i64 @main()
// CHECK:         switch i32

// CLEAN-NOT: jk.dispatch
// CLEAN-NOT: switch i32
