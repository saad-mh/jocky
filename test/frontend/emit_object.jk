// The backend can turn a program into a native object file. We do not link it
// here (that needs a linker; see the e2e tests) - we just check the object was
// written and still references printf.

// RUN: %jocky build --emit-obj "%s" -o "%t.obj"
// RUN: llvm-objdump -r "%t.obj" | %FileCheck "%s"

print(21 + 21);

// CHECK: RELOCATION RECORDS
// CHECK: printf
