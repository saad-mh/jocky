// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// L1.4 / L1.5 diagnostics: only `ptr +/- int`, `int + ptr`, and
// `ptr<T> - ptr<T>` are defined; `sizeof` needs a sized type.

let n = 5;
let p = &n;
let q = &n;

let a = p + q;      // ptr + ptr
let b = p * 2;      // no `*` on pointers
let c = 2 - p;      // int - ptr

let buf: char[4];
let cp = &buf[0];
let d = p - cp;     // mismatched element types

let e = sizeof(nothing);

// CHECK-DAG: :10:11: error: operator '+' cannot combine ptr<int> and ptr<int>
// CHECK-DAG: :11:11: error: operator '*' cannot combine ptr<int> and int
// CHECK-DAG: :12:11: error: operator '-' cannot combine int and ptr<int>
// CHECK-DAG: :16:11: error: subtracting incompatible pointer types ptr<int> and ptr<char>
// CHECK-DAG: :18:9: error: sizeof needs a sized type, not 'nothing'
