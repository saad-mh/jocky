// RUN: %jocky check "%s"
//
// `jocky check` runs the front end and semantic analysis only, with no
// codegen. A well-formed program produces no diagnostics and exits 0.

func add(a: int, b: int) -> int {
    var total = a + b;
    return total;
}

func is_negative(n: int) -> bool {
    return n < 0;
}

func scale(x: double, k: double) -> double {
    return x * k;
}

var x = add(2, 40);
while (x > 0) {
    x = x - 1;
}

var flag = is_negative(x);
var ratio = scale(1.5, 2.0);
var byte: u8 = 255;
var wide = byte as int;

print(flag);
print(ratio);
print(wide);
