// RUN: %jocky check "%s"
//
// `jocky check` runs the front end and semantic analysis only, with no
// codegen. A well-formed program produces no diagnostics and exits 0.

func add(a: int, b: int) -> int {
    let total = a + b;
    return total;
}

func is_negative(n: int) -> flag {
    return n < 0;
}

func scale(x: double, k: double) -> double {
    return x * k;
}

let x = add(2, 40);
while (x > 0) {
    x = x - 1;
}

let flag = is_negative(x);
let ratio = scale(1.5, 2.0);
let byte: u8 = 255;
let wide = byte to int;

print(flag);
print(ratio);
print(wide);
