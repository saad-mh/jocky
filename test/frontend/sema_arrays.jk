// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// Array / slice diagnostics (L0.6): indexing or `.len` on a non-sequence, a
// non-integer index, a heterogeneous array literal, an uninitialised slice, a
// non-constant array length, and an unknown element type.

var scalar = 5;
var a = scalar[0];
var b = scalar.len;

var nums: int[3] = [1, 2, 3];
var c = nums[nums];

var mixed = [1, true, 3];

var view: int[];

var flex: int[0 - 2];
var weird: nope[4];

// CHECK-DAG: :8:15: error: cannot index a value of type int
// CHECK-DAG: :9:15: error: '.len' needs an array or a slice, not int
// CHECK-DAG: :12:14: error: an array index must be an integer, not int[3]
// CHECK-DAG: :14:17: error: array element 1 has type bool but int was expected
// CHECK-DAG: :16:1: error: a slice variable ('view') must be given an initializer
// CHECK-DAG: :18:17: error: array length must be a constant non-negative integer
// CHECK-DAG: :19:12: error: unknown type 'nope'
