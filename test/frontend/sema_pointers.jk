// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// L1.2 / L1.3 diagnostics: dereferencing a non-pointer or a rawptr, `&` on a
// non-lvalue, mixing `ptr<T>` and `rawptr` without a cast, and `ptr<void>`.

var n = 5;

var a = *n;
var r: rawptr = &n as rawptr;
var b = *r;
var c = &7;

var pi: ptr<int> = &n;
var eq = pi == r;
var bad: ptr<int> = r;

var v: ptr<void>;

// CHECK-DAG: :8:9: error: cannot dereference a value of type int
// CHECK-DAG: :10:9: error: cannot dereference a rawptr (cast it to a ptr<T> first)
// CHECK-DAG: :11:9: error: '&' needs an addressable value
// CHECK-DAG: :14:13: error: comparing incompatible pointer types ptr<int> and rawptr (add an explicit `as`)
// CHECK-DAG: :15:21: error: cannot initialize 'bad' of type ptr<int> from a value of type rawptr (add an explicit `as ptr<int>`)
// CHECK-DAG: :17:8: error: use 'rawptr', not 'ptr<void>'
