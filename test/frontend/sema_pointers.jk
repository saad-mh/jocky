// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// L1.2 / L1.3 diagnostics: dereferencing a non-pointer or a rawptr, `&` on a
// non-lvalue, mixing `ptr<T>` and `rawptr` without a cast, and `ptr<void>`.

let n = 5;

let a = *n;
let r: rawptr = &n to rawptr;
let b = *r;
let c = &7;

let pi: ptr<int> = &n;
let eq = pi == r;
let bad: ptr<int> = r;

let v: ptr<nothing>;

// CHECK-DAG: :8:9: error: cannot dereference a value of type int
// CHECK-DAG: :10:9: error: cannot dereference a rawptr (cast it to a ptr<T> first)
// CHECK-DAG: :11:9: error: '&' needs an addressable value
// CHECK-DAG: :14:13: error: comparing incompatible pointer types ptr<int> and rawptr (add an explicit `to`)
// CHECK-DAG: :15:21: error: cannot initialize 'bad' of type ptr<int> from a value of type rawptr (add an explicit `to ptr<int>`)
// CHECK-DAG: :17:8: error: use 'rawptr', not 'ptr<nothing>'
