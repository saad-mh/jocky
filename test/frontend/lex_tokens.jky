// RUN: %jocky lex --dump-tokens "%s" | %FileCheck "%s"

func add(a, b) {
  var total = a + b;
  return total;
}

if (add(2, 40) >= 42) {
  print("hi\n");
}

// CHECK:      3:1: KwFunc 'func'
// CHECK-NEXT: 3:6: Identifier 'add'
// CHECK-NEXT: 3:9: LParen '('
// CHECK-NEXT: 3:10: Identifier 'a'
// CHECK-NEXT: 3:11: Comma ','
// CHECK-NEXT: 3:13: Identifier 'b'
// CHECK-NEXT: 3:14: RParen ')'
// CHECK-NEXT: 3:16: LBrace '{'
// CHECK-NEXT: 4:3: KwVar 'var'
// CHECK-NEXT: 4:7: Identifier 'total'
// CHECK-NEXT: 4:13: Assign '='
// CHECK-NEXT: 4:15: Identifier 'a'
// CHECK-NEXT: 4:17: Plus '+'
// CHECK-NEXT: 4:19: Identifier 'b'
// CHECK-NEXT: 4:20: Semicolon ';'
// CHECK-NEXT: 5:3: KwReturn 'return'
// CHECK-NEXT: 5:10: Identifier 'total'
// CHECK-NEXT: 5:15: Semicolon ';'
// CHECK-NEXT: 6:1: RBrace '}'
// CHECK-NEXT: 8:1: KwIf 'if'
// CHECK-NEXT: 8:4: LParen '('
// CHECK-NEXT: 8:5: Identifier 'add'
// CHECK-NEXT: 8:8: LParen '('
// CHECK-NEXT: 8:9: IntLiteral '2' int=2
// CHECK-NEXT: 8:10: Comma ','
// CHECK-NEXT: 8:12: IntLiteral '40' int=40
// CHECK-NEXT: 8:14: RParen ')'
// CHECK-NEXT: 8:16: GtEq '>='
// CHECK-NEXT: 8:19: IntLiteral '42' int=42
// CHECK-NEXT: 8:21: RParen ')'
// CHECK-NEXT: 8:23: LBrace '{'
// CHECK-NEXT: 9:3: Identifier 'print'
// CHECK-NEXT: 9:8: LParen '('
// CHECK-NEXT: 9:9: StringLiteral '"hi\n"' str="hi\n"
// CHECK-NEXT: 9:15: RParen ')'
// CHECK-NEXT: 9:16: Semicolon ';'
// CHECK-NEXT: 10:1: RBrace '}'
// CHECK-NEXT: {{[0-9]+}}:1: Eof
