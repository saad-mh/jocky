// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
// RUN: %not %jocky build --emit-llvm "%s" 2>&1 | %FileCheck "%s"
//
// The semantic-analysis stage resolves names and checks calls. Independent
// problems are all reported in one run, and both `check` and `build` enforce
// them (build stops before codegen).

func dup() { return 1; }
func dup() { return 2; }

func takesTwo(a: int, b: int) -> int { return a + b; }

print(undefinedVar);
print(takesTwo(1));
missing(3);
undeclared = 5;

// CHECK-DAG: :9:1: error: function 'dup' is defined more than once
// CHECK-DAG: :13:7: error: use of undeclared variable 'undefinedVar'
// CHECK-DAG: :14:7: error: function 'takesTwo' expects 2 argument(s) but 1 were given
// CHECK-DAG: :15:1: error: call to undefined function 'missing'
// CHECK-DAG: :16:1: error: use of undeclared variable 'undeclared'
