// RUN: %not %jocky check "%s" 2>&1 | %FileCheck "%s"
//
// L1.1 diagnostics: the bitwise and shift operators are integer-only.

let f = 1.5;
let a = ~f;
let b = f & 3;
let c = 1.0 << 2;
let d = 8 >> 1.5;

// CHECK-DAG: :6:9: error: unary '~' needs an integer, not double
// CHECK-DAG: :7:11: error: operator '&' needs integer operands
// CHECK-DAG: :8:13: error: operator '<<' needs integer operands, not double and int
// CHECK-DAG: :9:11: error: operator '>>' needs integer operands, not int and double
