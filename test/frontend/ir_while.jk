// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"

var i = 0;
var sum = 0;
while (i < 5) {
    sum = sum + i;
    i = i + 1;
}
print(sum);

// CHECK-LABEL: define i64 @main()
// CHECK:         br label %[[COND:[A-Za-z0-9_.]+]]
// CHECK:       [[COND]]:
// CHECK:         icmp slt i64
// CHECK:         br i1 {{.*}}, label %[[BODY:[A-Za-z0-9_.]+]], label %[[END:[A-Za-z0-9_.]+]]
// CHECK:       [[BODY]]:
// CHECK:         br label %[[COND]]
// CHECK:       [[END]]:
