// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L0.8: `print` picks its printf format from the argument's type.
//   int -> %lld, unsigned -> %llu (zext to i64), char -> %c (zext to i32),
//   bool -> %s with a "true"/"false" select, double/float -> %g (float fpext'd).

let s: int  = 1;
let u: u32  = 2;
let c: char = 'x';
let b: flag = yes;
let d: double = 1.5;
let f: float  = 2.5f;

print(s);
print(u);
print(c);
print(b);
print(d);
print(f);
print("lit");

// CHECK-DAG: @[[FINT:[A-Za-z0-9_.]+]] = private unnamed_addr constant [6 x i8] c"%lld\0A\00"
// CHECK-DAG: @[[FUINT:[A-Za-z0-9_.]+]] = private unnamed_addr constant [6 x i8] c"%llu\0A\00"
// CHECK-DAG: @[[FCHR:[A-Za-z0-9_.]+]] = private unnamed_addr constant [4 x i8] c"%c\0A\00"
// CHECK-DAG: @[[FSTR:[A-Za-z0-9_.]+]] = private unnamed_addr constant [4 x i8] c"%s\0A\00"
// CHECK-DAG: @[[FFLT:[A-Za-z0-9_.]+]] = private unnamed_addr constant [4 x i8] c"%g\0A\00"

// CHECK: call i32 (ptr, ...) @printf(ptr @[[FINT]], i64 %{{.*}})
// CHECK: zext i32 %{{.*}} to i64
// CHECK: call i32 (ptr, ...) @printf(ptr @[[FUINT]], i64 %{{.*}})
// CHECK: zext i8 %{{.*}} to i32
// CHECK: call i32 (ptr, ...) @printf(ptr @[[FCHR]], i32 %{{.*}})
// CHECK: select i1 %{{.*}}, ptr @{{.*}}, ptr @{{.*}}
// CHECK: call i32 (ptr, ...) @printf(ptr @[[FSTR]], ptr %{{.*}})
// CHECK: call i32 (ptr, ...) @printf(ptr @[[FFLT]], double %{{.*}})
// CHECK: fpext float %{{.*}} to double
// CHECK: call i32 (ptr, ...) @printf(ptr @[[FFLT]], double %{{.*}})
