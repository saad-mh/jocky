// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L2.1 / L2.3 lowering: an `extern "C"` becomes an `ExternalLinkage` declaration
// with the mapped signature; a JOCKY `bool` is `i32` at the ABI boundary
// (zext on the way in, `icmp ne 0` on the way out); `...` gives a varargs type.

extern "C" IsDebuggerPresent() -> bool;
extern "C" Beep(freq: u32, active: bool) -> bool;
extern "C" printf(fmt: ptr<char>, ...) -> i32;

var d = IsDebuggerPresent();
var ok = Beep(750u32, d);
print(ok);
var f = "%d\n";
printf(&f[0], 1);

// CHECK-DAG: declare i32 @IsDebuggerPresent()
// CHECK-DAG: declare i32 @Beep(i32, i32)
// CHECK-DAG: declare i32 @printf(ptr, ...)

// CHECK: %call = call i32 @IsDebuggerPresent()
// CHECK: icmp ne i32 %call, 0
// CHECK: zext i1 %{{.*}} to i32
// CHECK: call i32 @Beep(i32 750, i32 %{{.*}})
// CHECK: call i32 (ptr, ...) @printf(ptr %{{.*}}, i64 1)
