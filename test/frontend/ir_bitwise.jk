// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L1.1 lowering: & | ^ -> and / or / xor; ~ -> `xor -1`; << -> shl;
// >> -> ashr for a signed value, lshr for an unsigned one. A shift count of a
// different width is brought to the value's type first.

func ops(a: u32, b: u32, s: i32) -> u32 {
    let x = a & b;
    x = x | b;
    x = x ^ a;
    x = x << 3;
    x = x >> 2;          // u32 -> lshr
    x = ~x;
    let signed = s >> 1; // i32 -> ashr
    return x + (signed to u32);
}

func widen_count(v: u32, n: i64) -> u32 {
    return v << n;       // n truncated to i32 before the shift
}

print(ops(1u32, 2u32, 0i32) + widen_count(1u32, 4i64));

// CHECK: define i32 @ops(i32 %a, i32 %b, i32 %s)
// CHECK:   and i32
// CHECK:   or i32
// CHECK:   xor i32
// CHECK:   shl i32 %{{.*}}, 3
// CHECK:   lshr i32 %{{.*}}, 2
// CHECK:   xor i32 %{{.*}}, -1
// CHECK:   ashr i32 %{{.*}}, 1

// CHECK: define i32 @widen_count(i32 %v, i64 %n)
// CHECK:   trunc i64 %{{.*}} to i32
// CHECK:   shl i32
