// The `split` pass cuts a large basic block into two joined by a branch to a
// `jk.split` block; and a fixed --obf-seed is reproducible.

// RUN: %jocky build --emit-llvm --obfuscate=split --obf-seed 1 "%s" | %FileCheck "%s"
// RUN: %jocky build --emit-llvm "%s" | %FileCheck --check-prefix=CLEAN "%s"
// RUN: %jocky build --emit-llvm --obfuscate=split --obf-seed 5 "%s" > "%t.1.ll"
// RUN: %jocky build --emit-llvm --obfuscate=split --obf-seed 5 "%s" > "%t.2.ll"
// RUN: diff "%t.1.ll" "%t.2.ll"

let a = 1;
let b = a + 2;
let c = b + 3;
let d = c + 4;
let e = d + 5;
print(e);

// CHECK-LABEL: define i64 @main()
// CHECK:         br label %jk.split
// CHECK:       jk.split{{[0-9]*}}:

// CLEAN-NOT: jk.split
