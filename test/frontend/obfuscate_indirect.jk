// The `indirect` pass turns direct calls to user functions into a load from a
// `jk.fp.<name>` global (the callee address offset by a key) + a subtract + an
// indirect call. Calls to printf (a declaration) are left direct.

// RUN: %jocky build --emit-llvm --obfuscate=indirect --obf-seed 1 "%s" | %FileCheck "%s"
// RUN: %jocky build --emit-llvm "%s" | %FileCheck --check-prefix=CLEAN "%s"

func helper(a: int) -> int {
    return a * 3;
}

func other(b: int) -> int {
    return helper(b) + 1;
}

print(other(7));

// CHECK-DAG: @jk.fp.helper = {{.*}}global i64 add (i64 ptrtoint (ptr @helper to i64)
// CHECK-DAG: @jk.fp.other = {{.*}}global i64 add (i64 ptrtoint (ptr @other to i64)
// CHECK:       %jk.enc = load i64, ptr @jk.fp.helper
// CHECK:       %jk.dec = sub i64 %jk.enc,
// CHECK:       %jk.fp = inttoptr i64 %jk.dec to ptr
// CHECK:       call i64 %jk.fp(i64
// CHECK-LABEL: define i64 @main()
// CHECK:       call i64 %jk.fp(i64
// printf stays a direct call:
// CHECK:       call i32 (ptr, ...) @printf

// CLEAN-NOT: jk.fp
// CLEAN:     call i64 @helper
// CLEAN:     call i64 @other
