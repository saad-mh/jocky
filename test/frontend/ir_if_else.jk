// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"

func max(a, b) {
    if (a < b) {
        return b;
    } else {
        return a;
    }
}

print(max(3, 9));

// CHECK-LABEL: define i64 @max(i64 %a, i64 %b)
// CHECK:         %[[CMP:[A-Za-z0-9_.]+]] = icmp slt i64
// CHECK:         br i1 %[[CMP]], label %[[THEN:[A-Za-z0-9_.]+]], label %[[ELSE:[A-Za-z0-9_.]+]]
// CHECK:       [[THEN]]:
// CHECK:         ret i64
// CHECK:       [[ELSE]]:
// CHECK:         ret i64
