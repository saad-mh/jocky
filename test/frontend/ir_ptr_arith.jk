// RUN: %jocky build --emit-llvm "%s" | %FileCheck "%s"
//
// L1.4 lowering: `p + n` is a `getelementptr` scaled by the pointee type;
// `p - q` is `ptrtoint` on both, subtract, then `sdiv` by the element size;
// `addr as ptr<T>` / `p as u64` are `inttoptr` / `ptrtoint`. L1.5: `sizeof`
// folds to a constant.

func nth(base: ptr<int>, i: int) -> ptr<int> {
    return base + i;
}

func gap(a: ptr<int>, b: ptr<int>) -> int {
    return a - b;
}

var arr: int[4] = [0, 1, 2, 3];
var addr = &arr[0] as u64;
var back = (addr + 8) as ptr<int>;
print(*nth(&arr[0], 2) + gap(&arr[3], back) + sizeof(int[4]));

// CHECK: define ptr @nth(ptr %base, i64 %i)
// CHECK:   getelementptr i64, ptr %{{.*}}, i64 %{{.*}}

// CHECK: define i64 @gap(ptr %a, ptr %b)
// CHECK:   ptrtoint ptr %{{.*}} to i64
// CHECK:   ptrtoint ptr %{{.*}} to i64
// CHECK:   sub i64
// CHECK:   sdiv i64 %{{.*}}, 8

// CHECK-LABEL: define i64 @main()
// CHECK:   ptrtoint ptr %{{.*}} to i64
// CHECK:   inttoptr i64 %{{.*}} to ptr
// CHECK:   add i64 %{{.*}}, 32

