// Function declarations, parameters, calls, and return values.
// Parameters take a type annotation; the return type defaults to `int`.

func add(a: int, b: int) -> int {
    return a + b;
}

func max(a: int, b: int) -> int {
    if (a > b) {
        return a;
    }
    return b;
}

func square(n: int) -> int {
    return n * n;
}

print(add(2, 40));
print(max(11, 7));
print(square(add(1, 2)));
