// while loops, assignment, and check/otherwise.

// Sum 1..10.
let i = 1;
let total = 0;
while (i <= 10) {
    total = total + i;
    i = i + 1;
}
print(total);

// Count down, printing whether each number is even or odd (0 = even, 1 = odd).
let n = 5;
while (n > 0) {
    check (n % 2 == 0) {
        print(0);
    } otherwise {
        print(1);
    }
    n = n - 1;
}
