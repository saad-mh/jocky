// while loops, assignment, and if/else.

// Sum 1..10.
var i = 1;
var total = 0;
while (i <= 10) {
    total = total + i;
    i = i + 1;
}
print(total);

// Count down, printing whether each number is even or odd (0 = even, 1 = odd).
var n = 5;
while (n > 0) {
    if (n % 2 == 0) {
        print(0);
    } else {
        print(1);
    }
    n = n - 1;
}
